# Client-side environment. Copy to `.env` (git-ignored) and adjust.
#
# Only EXPO_PUBLIC_* variables reach the app, and they are inlined into the
# bundle in plain text — never put a secret here.

# Base URL of the backend. Leave unset in local development: the app falls back
# to the Expo packager's host on port 3000, which works from a simulator and
# from a physical device on the same network.
# EXPO_PUBLIC_API_URL=https://api.gathrly.app

# Google Sign-In client IDs (see AUTH_SETUP.md section 2). The web client ID is
# required for the returned idToken's audience to match what the backend checks.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
