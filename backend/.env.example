PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://<user>:<password>@localhost:5432/gathrly_dev

# Session tokens
JWT_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">
JWT_EXPIRES_IN=7d

# --- Sign in with Apple ---------------------------------------------------
# Comma-separated list of valid audiences: native app bundle id(s) + web
# "Services ID". Required to verify identityToken.
APPLE_CLIENT_IDS=com.gathrly.app
# Only needed for token revocation calls (unlink / account deletion):
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of the AuthKey_XXXX.p8 file. Use literal \n for newlines on one line.
APPLE_PRIVATE_KEY=

# --- Google Sign-In -----------------------------------------------------
# Comma-separated OAuth client ids used by the apps. Include ALL of them (iOS,
# Android, Web) - which one lands in the token's `aud` depends on the platform
# and on whether the client passes webClientId.
GOOGLE_CLIENT_IDS=

# --- Email OTP (SMTP, provider-agnostic) -------------------------------
# Leave SMTP_HOST empty in local dev: codes are printed to the server console.
# Verify a real config with:  npm run mail:test -- you@example.com
#
#   Resend    host smtp.resend.com      port 587  user "resend"      pass <api key>
#   Postmark  host smtp.postmarkapp.com port 587  user <server token> pass <server token>
#   SES       host email-smtp.<region>.amazonaws.com port 587 (SMTP credentials, not IAM keys)
#   Mailgun   host smtp.mailgun.org     port 587  user postmaster@<domain>
#
# Whichever you pick, verify your sending domain (SPF + DKIM) or the codes land in spam.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Gathrly <no-reply@gathrly.app>
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# NOTE: There are intentionally no SMS/phone provider variables (Twilio,
# Vonage, AWS SNS, 10DLC, sender numbers). Phone auth has been removed.
